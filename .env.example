# ============================================================================
# MATTIN AI — Single-host Docker deployment
# ============================================================================
# Sirve para desarrollo local y para despliegues en servidores de cliente.
# La única diferencia entre ambos es FRONTEND_URL y las credenciales.
# Esta es la UNICA plantilla de configuracion del proyecto: sirve para Docker y
# para desarrollo local. `docker/.env` es un symlink a `../.env`, y python-dotenv
# resuelve al `.env` de la raiz desde cualquier directorio del repo.
#
# Uso:
#   1. cp .env.example .env
#   2. Editar las variables de abajo
#   3. docker compose up -d --build
# ============================================================================

# ----------------------------------------------------------------------------
# URL pública
# ----------------------------------------------------------------------------
# Local:     http://localhost
# Cliente:   http://<ip-o-dominio-del-servidor>
# Backend (FRONTEND_URL/CORS) y frontend (VITE_API_BASE_URL) derivan de esto.
# Prefijo AICT_ a propósito: ninguna variable suelta de otro proyecto en tu
# shell puede pisarlo (Compose da prioridad al shell sobre el .env).
AICT_PUBLIC_URL=http://localhost

# Puerto en el que Caddy escucha en el host (cámbialo si 80 está ocupado)
HTTP_PORT=80

# Tag de las imágenes publicadas en GHCR que se descargarán con `docker compose pull`.
#   develop      → último build de la rama develop (por defecto)
#   sha-<hash>   → commit específico (p.ej. sha-c1feaaf) — recomendado en cliente
# Si prefieres construir en local desde código: `docker compose up -d --build`
IMAGE_TAG=develop

# ----------------------------------------------------------------------------
# Base de datos [REQUERIDO]
# ----------------------------------------------------------------------------
# DATABASE_PASSWORD no tiene valor por defecto: el compose falla si no lo
# defines aquí. Genera uno robusto (min 20 caracteres aleatorios).
DATABASE_USER=mattin
DATABASE_PASSWORD=
DATABASE_NAME=mattin_ai

# ----------------------------------------------------------------------------
# Autenticación [SECRET_KEY REQUERIDO]
# ----------------------------------------------------------------------------
# LOCAL: email+password gestionado por admin (self-hosted/SaaS)
# OIDC:  Entra ID / Azure AD (producción)
AICT_LOGIN=LOCAL

# SECRET_KEY no tiene valor por defecto: la app rechaza arrancar sin un valor
# fuerte. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# AVISO: rotar este valor invalida todas las sesiones activas (todos los
# usuarios quedarán deslogados porque los JWT existentes fallarán la firma).
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ----------------------------------------------------------------------------
# LOCAL AUTH MODE — solo si AICT_LOGIN=LOCAL
# Todas las variables son OPCIONALES; los valores mostrados son los defaults.
# ----------------------------------------------------------------------------

# Flag Secure en las cookies de auth (access_token, refresh_token, csrf_token).
# false aquí porque FRONTEND_URL=http://localhost es HTTP plano; el navegador
# no envía cookies con Secure=true sobre HTTP.
# ¡¡CAMBIAR A true EN PRODUCCIÓN DETRÁS DE HTTPS!!
AUTH_COOKIE_SECURE=false

# TTL del access token (JWT) en minutos.
# LOCAL_ACCESS_TTL_MINUTES=15

# TTL del refresh token en días. Al caducar el usuario debe volver a logarse.
# LOCAL_REFRESH_TTL_DAYS=14

# Bloqueo por intentos fallidos: número de contraseñas incorrectas consecutivas
# antes de bloquear la cuenta.
# LOCAL_LOCKOUT_THRESHOLD=5

# Duración base del bloqueo en segundos. Los bloqueos sucesivos siguen
# back-off exponencial: base * 2^(n_bloqueos - 1).
# LOCAL_LOCKOUT_BASE_SECONDS=60

# ----------------------------------------------------------------------------
# SMTP — opcional para los flujos de "establecer contraseña" de LOCAL auth.
# Si SMTP_HOST y SMTP_FROM están vacíos (por defecto) la app usa un
# NoopEmailSender que escribe el enlace en el log del backend en lugar de
# enviarlo por correo. Sin SMTP el modo LOCAL funciona igualmente; el operador
# solo tiene que copiar el enlace del log.
# Descomentar y rellenar únicamente si quieres envío real de correos.
# ----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=tu-password-smtp        # Nunca se loggea; tratada como secreto
# SMTP_TLS=true
# SMTP_FROM=no-reply@example.com
# SMTP_TIMEOUT_SECONDS=10

# Emails separados por coma que serán omniadmin
AICT_OMNIADMINS=admin@example.com

# Usuarios a sembrar en modo LOCAL con el script
# `docker compose exec backend python -m utils.seed_dev_users` (o los wrappers
# seed-users.ps1 / seed-users.sh). Formato CSV "email:Nombre[:password]", el nombre es
# opcional. Si se deja vacío, el script usa una lista de usuarios por defecto.
# AICT_DEV_SEED_USERS=admin@cliente.com:Admin,dev@cliente.com:Dev

# Solo si AICT_LOGIN=OIDC
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Claves de proveedores de IA
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# ----------------------------------------------------------------------------
# Base vectorial
# ----------------------------------------------------------------------------
# PGVECTOR (usa Postgres) o QDRANT
VECTOR_DB_TYPE=PGVECTOR
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false

# ----------------------------------------------------------------------------
# Configuración de la aplicación
# ----------------------------------------------------------------------------
AICT_MODE=SELF-HOSTED
REPO_BASE_FOLDER=./data/repositories

# ----------------------------------------------------------------------------
# Limpieza de ficheros temporales subidos al chatear con agentes
# ----------------------------------------------------------------------------
# Un worker en background barre data/tmp/ para que un agente con mucho
# trafico (p.ej. Vision con API key fija) no llene el disco del host.
#  - Ephemeral (sin memoria o sin conversation_id): se borra al terminar
#    cada chat; el sweep es un backstop por si el request muere antes.
#  - Persistent (memoria + conversation_id): expira tras N dias de
#    inactividad, siguiendo la convencion de OpenAI Threads.
# Defaults sensatos; descomentar solo si necesitas ajustar.
# TMP_PERSISTENT_TTL_DAYS=7
# TMP_EPHEMERAL_ORPHAN_HOURS=1
# TMP_CLEANUP_INTERVAL_MINUTES=60
# TMP_CLEANUP_ENABLED=True

# ----------------------------------------------------------------------------
# Pool de procesos uvicorn del backend
# ----------------------------------------------------------------------------
# Cada worker es un proceso Python independiente con FastAPI + SQLAlchemy +
# LangChain (~0.5–1.5 GB RSS). Default 2 cubre un host monoinquilino con
# 4 GB libres; subir a 4 en servidores >= 8 GB libres para el backend, bajar
# a 1 en hosts dev/demo. El pool de conexiones a la BD es POR worker, asi
# que conexiones totales = UVICORN_WORKERS * pool_size.
#
# Nota sobre los logs de arranque: con N workers veras N lineas
# "Application startup complete" separadas por unos segundos — cada worker
# ejecuta su propio lifespan en su proceso. Es normal, no un crash. El
# cleanup task solo corre en uno de ellos (eleccion de leader via
# fcntl.flock sobre $TMP_BASE_FOLDER/.cleanup.lock); los demas loggean
# "another worker holds the leader lock; not starting".
# UVICORN_WORKERS=2
# UVICORN_LIMIT_CONCURRENCY=100

# Modo de despliegue: self_managed (por defecto) o saas
# Solo cambiar a saas si vais a operar con suscripciones Stripe, tiers, etc.
# AICT_DEPLOYMENT_MODE=self_managed

# ----------------------------------------------------------------------------
# Observabilidad (opcional)
# Dos modos:
#   1) Por App (recomendado): cada App guarda su key en la UI (Settings de App).
#      Las variables de abajo se IGNORAN para apps con key configurada.
#   2) Fallback global: si una App no tiene key y LANGSMITH_TRACING es truthy,
#      se usan estas variables. Útil para desarrollo local.
#
# IMPORTANTE — regiones: LangSmith aloja las cuentas EU en un endpoint
# distinto. Si tu cuenta se creó en EU (smith.langchain.com te lleva a
# eu.smith.langchain.com), cambia LANGSMITH_ENDPOINT al endpoint EU. Si te
# equivocas de región obtendrás 403 Forbidden en todo menos /info.
#   US: https://api.smith.langchain.com  (default)
#   EU: https://eu.api.smith.langchain.com
# ----------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# ----------------------------------------------------------------------------
# OIDC del frontend (solo si usáis OIDC)
# ----------------------------------------------------------------------------
VITE_OIDC_ENABLED=false
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_AUDIENCE=

# ----------------------------------------------------------------------------
# LightRAG — RAG con grafo de conocimiento
# ----------------------------------------------------------------------------
# LightRAG combina vector search (Qdrant/PGVector) con un grafo de
# conocimiento en Neo4j para mejorar el recall en preguntas multi-hop.
# Neo4j se levanta siempre como parte del stack. Pon LIGHTRAG_ENABLED=false
# si quieres desactivar la funcionalidad LightRAG en el backend (Neo4j
# seguirá arrancando pero el backend no lo usará).
# ----------------------------------------------------------------------------
LIGHTRAG_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j

# --- Rendimiento de indexación ---------------------------------------------
# Concurrencia. Los defaults de LightRAG (3/4/8) dejan una GPU local a medio
# gas: con MAX_PARALLEL_INSERT=3 solo hay 3 peticiones en vuelo. Mira el log de
# tu servidor vLLM y sube mientras `Waiting: 0` y `GPU KV cache usage` < ~80%.
MAX_PARALLEL_INSERT=48           # documentos (= páginas de PDF) a la vez
MAX_ASYNC_LLM=48                 # llamadas LLM concurrentes por rol
EMBEDDING_FUNC_MAX_ASYNC=32      # llamadas de embedding concurrentes
# Techo por llamada al LLM (segundos). Es tambien lo que tarda en detectarse un
# socket colgado —suspension del portatil, host del LLM apagado— antes de que el
# lote se aborte y quede reanudable desde el boton del repositorio.
LLM_TIMEOUT=120

# Tope de tokens de salida para la extracción de entidades. Sin esto, un
# servidor OpenAI-compatible como vLLM pone max_tokens = "lo que queda de
# ventana" (~30k) y un modelo que empieza a inventarse relaciones genera hasta
# ese techo: minutos por página. El prompt pide como máximo 100 registros, que
# caben en ~4-6k tokens.
# CONTRAPARTIDA: si se corta, el JSON no parsea y esa página se pierde
# (cuenta como fallida y la barra de progreso sigue). Cambia un éxito lento por
# un fallo rápido. Coméntalo para volver al comportamiento del proveedor.
LIGHTRAG_EXTRACT_MAX_TOKENS=8192

# Manda el esquema JSON al servidor como `response_format`, para que restrinja la
# generacion en vez de solo pedirla por prompt. Solo se aplica a proveedores con
# el parametro json_schema de estilo OpenAI (vLLM, OpenAI, Azure, OpenRouter) y
# solo a las llamadas de extraccion. Ponlo a false si tu servidor lo rechaza.
LIGHTRAG_EXTRACT_GUIDED_JSON=true

# --- Presupuesto de consulta -------------------------------------------------
# Cuantos chunks de texto llegan al contexto que lee el LLM del agente.
# LightRAG lo lee al importar, asi que va aqui y no en Python.
CHUNK_TOP_K=30
#
# Techo del contexto completo. NO es independiente del anterior: LightRAG
# reparte este presupuesto y los chunks se quedan con lo que sobra.
#
#   MAX_TOTAL_TOKENS >= MAX_ENTITY_TOKENS (6000, default)
#                     + MAX_RELATION_TOKENS (8000, default)
#                     + CHUNK_TOP_K x chunk_token_size (1200 por defecto)
#                     + prompt + consulta + ~1000 de margen
#
# Con los defaults de LightRAG la cuenta NO cuadra (6000+8000+24000 = 38000 >
# 30000): nunca llegan los 20 chunks, se truncan a ~12 sin avisar. Si subes
# CHUNK_TOP_K, sube esto tambien o no hara nada. Y no lo pongas por encima del
# max_model_len del LLM que consume el contexto.
MAX_TOTAL_TOKENS=100000

# Numero de ENTIDADES/relaciones del grafo que se recuperan (el top_k de
# LightRAG). Es el default para agentes nuevos y el fallback cuando un agente
# no tiene rag_k propio; cada agente puede sobreescribirlo desde su ficha.
# En modo naive no hay grafo y este valor no se usa: alli manda CHUNK_TOP_K.
AGENT_DEFAULT_RAG_K=20

# Cuantos chunks se cogen de CADA entidad/relacion antes del recorte global de
# CHUNK_TOP_K. Subirlo solo sirve si te quedas sin candidatos: mira el log
# "Selecting N from M entity-related chunks" — si M apenas supera CHUNK_TOP_K,
# subelo; si M es varias veces mayor, el cuello esta en CHUNK_TOP_K, no aqui.
RELATED_CHUNK_NUMBER=5

# El numero de ENTIDADES/relaciones del grafo (top_k) no se configura aqui: es
# Agent.rag_k, por agente, default 30. El retriever siempre lo pasa explicito,
# asi que una variable TOP_K en este fichero no tendria ningun efecto.
# En modo naive no hay grafo y solo cuenta CHUNK_TOP_K.

# ----------------------------------------------------------------------------
# Desarrollo local SIN Docker (uvicorn/npm a mano)
# ----------------------------------------------------------------------------
# El compose IGNORA estos valores: docker-compose.yaml fija la topologia del
# contenedor (DATABASE_HOST: postgres, puerto 5432, y construye
# SQLALCHEMY_DATABASE_URI apuntando al servicio postgres). Por eso un
# `localhost` aqui no puede filtrarse dentro de un contenedor.
# Descomenta solo si arrancas el backend fuera de Docker.
# DATABASE_HOST=localhost
# DATABASE_PORT=5434
# SQLALCHEMY_DATABASE_URI=postgresql://mattin:PASSWORD@localhost:5434/mattin_ai
#
# El frontend en modo dev (Vite) lee frontend/.env, no este fichero.
# FRONTEND_URL=http://localhost:5173
# VITE_API_BASE_URL=http://localhost:8000
