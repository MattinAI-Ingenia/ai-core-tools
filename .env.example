# MATTIN AI - Configuración de Entorno

# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env
# 2. Rellena las variables marcadas como [REQUERIDO]
# 3. Ejecuta: docker-compose up -d


#AUTENTICACIÓN [REQUERIDO elegir modo]
# 
# DESARROLLO / SELF-HOSTED (email + password local):
#    AICT_LOGIN=LOCAL
#    (AICT_LOGIN=FAKE ha sido retirado; usa LOCAL en su lugar)
#
# PRODUCCIÓN (Microsoft Entra ID / Azure AD):
#    AICT_LOGIN=OIDC
#    (requiere configurar las variables ENTRA_* más abajo)

AICT_LOGIN=LOCAL

#BASE DE DATOS
# Estos valores funcionan directamente con docker-compose
# Solo cámbialos si necesitas credenciales específicas

DATABASE_USER=mattin
DATABASE_PASSWORD=PASSWORD
DATABASE_NAME=mattin_ai
DATABASE_PORT=5434

# Para desarrollo LOCAL (sin Docker), descomenta:
DATABASE_HOST=localhost
SQLALCHEMY_DATABASE_URI=postgresql://mattin:PASSWORD@localhost:5434/mattin_ai

#CLAVES API DE IA [OPCIONAL]
# Puedes configurar las claves de API aquí o desde la interfaz web.
# Solo son necesarias cuando quieras usar modelos de IA.
# 
# Obtén tus claves en:
# - OpenAI:    https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
# - Mistral:   https://console.mistral.ai/

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

#ADMINISTRADORES [REQUERIDO]
# Lista de emails separados por coma que serán administradores

AICT_OMNIADMINS=

#SEGURIDAD [RECOMENDADO cambiar en producción]
# Clave secreta para firmar tokens JWT
# Genera una nueva con: python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=cambia-esto-en-produccion-genera-una-clave-aleatoria-aqui

#URLs
# Docker Compose (por defecto):
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Para desarrollo local (sin Docker), cambia a:
# VITE_API_BASE_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:5173

# Para producción, usa tus dominios:
# VITE_API_BASE_URL=https://api.tudominio.com
# FRONTEND_URL=https://tudominio.com

#ENTRA ID - AZURE AD (solo si AICT_LOGIN=OIDC)
# Obtén estos valores en Azure Portal > App registrations > Tu app
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Variables OIDC para el frontend (solo si AICT_LOGIN=OIDC)
VITE_OIDC_ENABLED=false
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=http://localhost:3000/auth/success
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_AUDIENCE=


#LANGSMITH (Opcional - trazabilidad de LLM)
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=

#CONFIGURACIÓN AVANZADA (normalmente no necesitas cambiar)
AICT_MODE=SELF-HOSTED
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REPO_BASE_FOLDER=./data/repositories
 
#--------------------------------------------------------------------------
# ----------------------------------------------------------------------------
# LightRAG — RAG con grafo de conocimiento
# ----------------------------------------------------------------------------
# LightRAG combina vector search (Qdrant/PGVector) con un grafo de
# conocimiento en Neo4j para mejorar el recall en preguntas multi-hop.
# Neo4j se levanta siempre como parte del stack. Pon LIGHTRAG_ENABLED=false
# si quieres desactivar la funcionalidad LightRAG en el backend (Neo4j
# seguirá arrancando pero el backend no lo usará).
# ----------------------------------------------------------------------------
LIGHTRAG_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Controla el número máximo de iteraciones de "gleaning" que ejecuta el
# pipeline de extracción de entidades durante el indexado de documentos.
# 0 desactiva el re-procesado adicional (valor por defecto recomendado para empezar).
ENTITY_EXTRACT_MAX_GLEANING=0
